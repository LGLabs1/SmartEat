rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /email_verifications/{docId} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserDoc() {
      return isSignedIn() && exists(userDocPath());
    }

    function userDoc() {
      return hasUserDoc() ? get(userDocPath()).data : null;
    }

    function userEateryId() {
      return hasUserDoc() ? userDoc().eateryId : null;
    }

    function isAdmin() {
      return hasUserDoc() && (
        userDoc().isAdmin == true
        || userDoc().role == 'admin'
      );
    }

    function isApprovedStaff() {
      return hasUserDoc() && (userDoc().approved == true || !(userDoc().approved is bool));
    }

    function canAccessEateryData(docEateryId) {
      return hasUserDoc()
        && docEateryId == userEateryId()
        && (isAdmin() || isApprovedStaff());
    }

    function canAccessEatery(eateryId) {
      return hasUserDoc()
        && eateryId == userEateryId()
        && (isAdmin() || isApprovedStaff());
    }

    // NEW: Staff/admin can complete orders
    function isOrderCompleteUpdate(eateryId) {
      return resource.data.status == 'pending'
        && request.resource.data.eateryId == resource.data.eateryId
        && request.resource.data.eateryId == eateryId
        && request.resource.data.status == 'completed'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status',
          'completedAt',
          'updatedAt'
        ]);
    }

    // NEW: Staff/admin can toggle menu availability (isAvailable only)
    function isMenuAvailabilityToggleUpdate(eateryId) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'isAvailable',
        'updatedAt'
      ]);
    }

    function isPendingOrderAppendUpdate(eateryId) {
      return resource.data.status == 'pending'
        && request.resource.data.eateryId == resource.data.eateryId
        && request.resource.data.eateryId == eateryId
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'items',
          'totalAmount',
          'updatedAt'
        ])
        && request.resource.data.items is list
        && request.resource.data.totalAmount is number;
    }

    function isPendingOrderVoidOrPartialVoidUpdate(eateryId) {
      return resource.data.status == 'pending'
        && request.resource.data.eateryId == resource.data.eateryId
        && request.resource.data.eateryId == eateryId
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'items',
          'totalAmount',
          'status',
          'voidReason',
          'voidedAt',
          'voidedBy',
          'updatedAt'
        ])
        && request.resource.data.items is list
        && request.resource.data.totalAmount is number
        && (request.resource.data.status == 'pending' || request.resource.data.status == 'voided');
    }

    // UPDATED: removed dependency on menu doc having eateryId field
    function isMenuStockOnlyUpdate(eateryId) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'availableServings',
        'isAvailable',
        'updatedAt',
        'inventoryItemId'
      ]);
    }

    // UPDATED: removed dependency on inventory doc having eateryId field
    function isInventoryStockOnlyUpdate(eateryId) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'currentStock',
        'updatedAt'
      ]);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      allow read: if isAdmin() && resource.data.eateryId == userEateryId();

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.isAdmin is bool;

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.isAdmin == resource.data.isAdmin
        && request.resource.data.role == resource.data.role
        && request.resource.data.eateryId == resource.data.eateryId
        && request.resource.data.approved == resource.data.approved;

      allow update: if isAdmin()
        && resource.data.eateryId == userEateryId();

      allow delete: if false;
    }

    match /eateries/{eateryId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.eateryId == eateryId;
      allow update, delete: if false;
    }

    match /eateries/{eateryId}/menu/{docId} {
      allow read: if canAccessEatery(eateryId);

      allow create: if isAdmin()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId;

      allow update, delete: if isAdmin()
        && eateryId == userEateryId();

      // Staff/admin stock-only updates (includes servings, isAvailable, inventory link)
      allow update: if canAccessEatery(eateryId)
        && isMenuStockOnlyUpdate(eateryId);

      // NEW: Staff/admin can toggle availability (isAvailable field only)
      allow update: if canAccessEatery(eateryId)
        && isMenuAvailabilityToggleUpdate(eateryId);
    }

    match /eateries/{eateryId}/orders/{docId} {
      allow read: if canAccessEatery(eateryId);

      allow create: if canAccessEatery(eateryId)
        && request.resource.data.eateryId == eateryId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.status == 'pending';

      allow update: if isAdmin()
        && eateryId == userEateryId();

      // Staff/admin: append items to pending orders
      allow update: if canAccessEatery(eateryId)
        && isPendingOrderAppendUpdate(eateryId);

      // Staff/admin: void/partial void on pending orders
      allow update: if canAccessEatery(eateryId)
        && isPendingOrderVoidOrPartialVoidUpdate(eateryId);

      // NEW: Staff/admin: complete orders
      allow update: if canAccessEatery(eateryId)
        && isOrderCompleteUpdate(eateryId);

      allow delete: if isAdmin()
        && eateryId == userEateryId();
    }

    match /eateries/{eateryId}/inventory/{docId} {
      allow read: if canAccessEatery(eateryId);

      allow create: if isAdmin()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId;

      allow update, delete: if isAdmin()
        && eateryId == userEateryId();

      // Staff/admin stock-only updates
      allow update: if canAccessEatery(eateryId)
        && isInventoryStockOnlyUpdate(eateryId);
    }

    match /eateries/{eateryId}/inventory_usage/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if isAdmin()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId;
      allow update, delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/recipes/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if isAdmin()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId;
      allow update, delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/staff_profiles/{uid} {
      allow read: if canAccessEatery(eateryId);
      allow create: if isAdmin()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId
        && request.resource.data.uid == uid
        && request.resource.data.uid is string
        && request.resource.data.dailyRate is number
        && (!('halfDayMultiplier' in request.resource.data)
          || request.resource.data.halfDayMultiplier is number);
      allow update: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId
        && request.resource.data.eateryId == eateryId
        && request.resource.data.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.dailyRate is number
        && (!('halfDayMultiplier' in request.resource.data)
          || request.resource.data.halfDayMultiplier is number);
      allow delete: if false;
    }

    match /eateries/{eateryId}/analytics_daily/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create, update, delete: if isAdmin() && eateryId == userEateryId();
    }

    match /eateries/{eateryId}/predictions/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create, update, delete: if isAdmin() && eateryId == userEateryId();
    }

    match /eateries/{eateryId}/expenses/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if isSignedIn()
        && isAdmin()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId;
      allow update, delete: if isSignedIn()
        && isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/payables/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if canAccessEatery(eateryId)
        && request.resource.data.eateryId == eateryId
        && request.resource.data.keys().hasAll(['name', 'amount']);
      allow update: if canAccessEatery(eateryId)
        && resource.data.eateryId == eateryId
        && request.resource.data.eateryId == eateryId;
      allow delete: if isSignedIn()
        && isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/notifications/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if isSignedIn()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId;
      allow update: if isSignedIn()
        && canAccessEatery(eateryId)
        && resource.data.eateryId == eateryId
        && request.resource.data.eateryId == eateryId;
      allow delete: if isSignedIn()
        && isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/settings/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if canAccessEatery(eateryId)
        && request.resource.data.eateryId == eateryId;
      allow update: if canAccessEatery(eateryId)
        && resource.data.eateryId == eateryId
        && request.resource.data.eateryId == eateryId;
      allow delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /menu/{docId} {
      allow read, write: if false;
    }

    match /orders/{docId} {
      allow read, write: if false;
    }

    match /inventory/{docId} {
      allow read, write: if false;
    }

    match /inventory_usage/{docId} {
      allow read, write: if false;
    }

    match /analytics/{docId} {
      allow read, write: if false;
    }

    match /recipes/{docId} {
      allow read, write: if false;
    }

    match /staff_profiles/{docId} {
      allow read, write: if false;
    }

    match /eateries/{eateryId}/staff_attendance/{docId} {
      allow read: if canAccessEatery(eateryId);

      // Staff can create their own attendance record for self check-in
      allow create: if canAccessEatery(eateryId)
        && request.resource.data.eateryId == eateryId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.date is string
        && request.resource.data.uid is string
        && (
          // Self check-in: has morning or afternoon check-in timestamps
          ('morningCheckIn' in request.resource.data
            || 'afternoonCheckIn' in request.resource.data)
          // Admin manual encoding: has present and workUnit
          || (request.resource.data.present is bool
              && (!('workUnit' in request.resource.data)
                || request.resource.data.workUnit is number))
        );

      // Staff can update their own record for check-ins (morning/afternoon)
      allow update: if canAccessEatery(eateryId)
        && resource.data.eateryId == eateryId
        && request.resource.data.eateryId == resource.data.eateryId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.date == resource.data.date
        // Only allow adding check-in timestamps (self check-in)
        && (
          request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'morningCheckIn',
            'afternoonCheckIn',
            'updatedAt'
          ])
          // Or admin updating present/workUnit/status
          || (
            request.resource.data.present is bool
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'present',
              'workUnit',
              'status',
              'notes',
              'updatedAt',
              'morningCheckIn',
              'afternoonCheckIn'
            ])
          )
        );

      allow delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/admin_profiles/{uid} {
      allow read: if canAccessEatery(eateryId);
      allow create: if isAdmin()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId
        && request.resource.data.uid == uid
        && request.resource.data.uid is string;
      allow update: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId
        && request.resource.data.eateryId == resource.data.eateryId
        && request.resource.data.uid == uid
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/staff_meals/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if canAccessEatery(eateryId)
        && request.resource.data.eateryId == eateryId
        && request.resource.data.staffId is string
        && request.resource.data.items is list
        && request.resource.data.status in ['pending', 'completed'];
      allow update: if canAccessEatery(eateryId)
        && resource.data.eateryId == eateryId
        && request.resource.data.eateryId == resource.data.eateryId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/payroll_payouts/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if canAccessEatery(eateryId)
        && request.resource.data.eateryId == eateryId
        && request.resource.data.uid is string
        && request.resource.data.weekStart is string
        && request.resource.data.amount is number
        && (!('type' in request.resource.data)
          || request.resource.data.type in ['weekly', 'advance']);
      allow update: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId
        && request.resource.data.eateryId == resource.data.eateryId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.weekStart == resource.data.weekStart
        && request.resource.data.amount is number
        && (!('type' in request.resource.data)
          || request.resource.data.type == resource.data.type);
      allow delete: if false;
    }

    match /notifications/{docId} {
      allow read: if isSignedIn()
        && resource.data.eateryId == userEateryId()
        && (isAdmin() || isApprovedStaff());
      allow create: if isSignedIn()
        && request.resource.data.eateryId == userEateryId();
      allow update: if isSignedIn()
        && resource.data.eateryId == userEateryId()
        && request.resource.data.eateryId == resource.data.eateryId
        && (isAdmin() || isApprovedStaff());
      allow delete: if isSignedIn()
        && isAdmin()
        && resource.data.eateryId == userEateryId();
    }

    match /user_preferences/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['notificationsEnabled', 'lowStockEnabled', 'billRemindersEnabled', 'orderAlertsEnabled']);
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.auth.uid == resource.data.userId;
      allow delete: if false;
    }
  }
}
