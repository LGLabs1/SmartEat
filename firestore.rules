rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /email_verifications/{docId} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function userEateryId() {
      return userDoc() != null ? userDoc().eateryId : null;
    }

    function isAdmin() {
      return isSignedIn() && (
        userDoc().isAdmin == true
        || userDoc().role == 'admin'
      );
    }

    function isApprovedStaff() {
      return isSignedIn() && (userDoc().approved == true || !(userDoc().approved is bool));
    }

    function canAccessEateryData(docEateryId) {
      return isSignedIn()
        && docEateryId == userEateryId()
        && (isAdmin() || isApprovedStaff());
    }

    function canAccessEatery(eateryId) {
      return isSignedIn()
        && eateryId == userEateryId()
        && (isAdmin() || isApprovedStaff());
    }

    function isPendingOrderAppendUpdate(eateryId) {
      return resource.data.status == 'pending'
        && request.resource.data.eateryId == resource.data.eateryId
        && request.resource.data.eateryId == eateryId
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'items',
          'totalAmount',
          'updatedAt'
        ])
        && request.resource.data.items is list
        && request.resource.data.totalAmount is number;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      allow read: if isAdmin() && resource.data.eateryId == userEateryId();

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.isAdmin is bool;

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.isAdmin == resource.data.isAdmin
        && request.resource.data.role == resource.data.role
        && request.resource.data.eateryId == resource.data.eateryId
        && request.resource.data.approved == resource.data.approved;

      allow update: if isAdmin()
        && resource.data.eateryId == userEateryId();

      allow delete: if false;
    }

    match /eateries/{eateryId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.eateryId == eateryId;
      allow update, delete: if false;
    }

    match /eateries/{eateryId}/menu/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if isAdmin()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId;
      allow update, delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/orders/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if canAccessEatery(eateryId)
        && request.resource.data.eateryId == eateryId;
      allow update: if isAdmin()
        && eateryId == userEateryId();
      allow update: if canAccessEatery(eateryId)
        && isPendingOrderAppendUpdate(eateryId);
      allow delete: if isAdmin()
        && eateryId == userEateryId();
    }

    match /eateries/{eateryId}/inventory/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if isAdmin()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId;
      allow update, delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/inventory_usage/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if isAdmin()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId;
      allow update, delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/recipes/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if isAdmin()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId;
      allow update, delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/staff_profiles/{uid} {
      allow read: if canAccessEatery(eateryId);
      allow create: if isAdmin()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId
        && request.resource.data.uid == uid
        && request.resource.data.uid is string
        && request.resource.data.dailyRate is number
        && (!('halfDayMultiplier' in request.resource.data)
          || request.resource.data.halfDayMultiplier is number);
      allow update: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId
        && request.resource.data.eateryId == eateryId
        && request.resource.data.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.dailyRate is number
        && (!('halfDayMultiplier' in request.resource.data)
          || request.resource.data.halfDayMultiplier is number);
      allow delete: if false;
    }

    match /eateries/{eateryId}/analytics_daily/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create, update, delete: if isAdmin() && eateryId == userEateryId();
    }

    match /eateries/{eateryId}/predictions/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create, update, delete: if isAdmin() && eateryId == userEateryId();
    }

    match /eateries/{eateryId}/expenses/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if isSignedIn()
        && isAdmin()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId;
      allow update, delete: if isSignedIn()
        && isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/payables/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if canAccessEatery(eateryId)
        && request.resource.data.eateryId == eateryId
        && request.resource.data.keys().hasAll(['name', 'amount']);
      allow update: if canAccessEatery(eateryId)
        && resource.data.eateryId == eateryId
        && request.resource.data.eateryId == eateryId;
      allow delete: if isSignedIn()
        && isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/notifications/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if isSignedIn()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId;
      allow update: if isSignedIn()
        && canAccessEatery(eateryId)
        && resource.data.eateryId == eateryId
        && request.resource.data.eateryId == eateryId;
      allow delete: if isSignedIn()
        && isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/settings/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if canAccessEatery(eateryId)
        && request.resource.data.eateryId == eateryId;
      allow update: if canAccessEatery(eateryId)
        && resource.data.eateryId == eateryId
        && request.resource.data.eateryId == eateryId;
      allow delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /menu/{docId} {
      allow read, write: if false;
    }

    match /orders/{docId} {
      allow read, write: if false;
    }

    match /inventory/{docId} {
      allow read, write: if false;
    }

    match /inventory_usage/{docId} {
      allow read, write: if false;
    }

    match /analytics/{docId} {
      allow read, write: if false;
    }

    match /recipes/{docId} {
      allow read, write: if false;
    }

    match /staff_profiles/{docId} {
      allow read, write: if false;
    }

    match /eateries/{eateryId}/staff_attendance/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if canAccessEatery(eateryId)
        && request.resource.data.eateryId == eateryId
        && request.resource.data.uid is string
        && request.resource.data.date is string
        && request.resource.data.present is bool
        && (!('workUnit' in request.resource.data)
          || request.resource.data.workUnit is number);
      allow update: if canAccessEatery(eateryId)
        && resource.data.eateryId == eateryId
        && request.resource.data.eateryId == resource.data.eateryId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.date == resource.data.date
        && request.resource.data.present is bool
        && (!('workUnit' in request.resource.data)
          || request.resource.data.workUnit is number);
      allow delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/admin_profiles/{uid} {
      allow read: if canAccessEatery(eateryId);
      allow create: if isAdmin()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId
        && request.resource.data.uid == uid
        && request.resource.data.uid is string;
      allow update: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId
        && request.resource.data.eateryId == resource.data.eateryId
        && request.resource.data.uid == uid
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/staff_meals/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if canAccessEatery(eateryId)
        && request.resource.data.eateryId == eateryId
        && request.resource.data.staffId is string
        && request.resource.data.items is list
        && request.resource.data.status in ['pending', 'completed'];
      allow update: if canAccessEatery(eateryId)
        && resource.data.eateryId == eateryId
        && request.resource.data.eateryId == resource.data.eateryId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/payroll_payouts/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if canAccessEatery(eateryId)
        && request.resource.data.eateryId == eateryId
        && request.resource.data.uid is string
        && request.resource.data.weekStart is string
        && request.resource.data.amount is number
        && (!('type' in request.resource.data)
          || request.resource.data.type in ['weekly', 'advance']);
      allow update: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId
        && request.resource.data.eateryId == resource.data.eateryId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.weekStart == resource.data.weekStart
        && request.resource.data.amount is number
        && (!('type' in request.resource.data)
          || request.resource.data.type == resource.data.type);
      allow delete: if false;
    }

    match /notifications/{docId} {
      allow read: if isSignedIn()
        && resource.data.eateryId == userEateryId()
        && (isAdmin() || isApprovedStaff());
      allow create: if isSignedIn()
        && request.resource.data.eateryId == userEateryId();
      allow update: if isSignedIn()
        && resource.data.eateryId == userEateryId()
        && request.resource.data.eateryId == resource.data.eateryId
        && (isAdmin() || isApprovedStaff());
      allow delete: if isSignedIn()
        && isAdmin()
        && resource.data.eateryId == userEateryId();
    }

    match /user_preferences/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['notificationsEnabled', 'lowStockEnabled', 'billRemindersEnabled', 'orderAlertsEnabled']);
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.auth.uid == resource.data.userId;
      allow delete: if false;
    }
  }
}
