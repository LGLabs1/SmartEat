rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /email_verifications/{docId} {
      allow read, write: if false;
    }

    match /password_reset_requests/{docId} {
      allow read, write: if false;
    }

    match /password_reset_rate_limits/{docId} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserDoc() {
      return isSignedIn() && exists(userDocPath());
    }

    function userDoc() {
      return hasUserDoc() ? get(userDocPath()).data : null;
    }

    function userEateryId() {
      return hasUserDoc() ? userDoc().eateryId : null;
    }

    function isAdmin() {
      return hasUserDoc() && (
        userDoc().isAdmin == true
        || userDoc().isAdmin == 'true'
        || userDoc().isAdmin == 1
        || userDoc().role == 'admin'
      );
    }

    function isApprovedStaff() {
      return hasUserDoc() && (
        userDoc().approved == true
        || userDoc().approved == 'true'
        || userDoc().approved == 1
        || userDoc().role == 'admin'
        || userDoc().isAdmin == true
        || userDoc().isAdmin == 'true'
        || userDoc().isAdmin == 1
        // Legacy accounts predate the approval flag and are treated as approved.
        || !('approved' in userDoc())
      );
    }

    function canAccessEateryData(docEateryId) {
      return hasUserDoc()
        && docEateryId == userEateryId()
        && (isAdmin() || isApprovedStaff());
    }

    function canAccessEatery(eateryId) {
      return hasUserDoc()
        && userDoc().eateryId == eateryId
        && (isAdmin() || isApprovedStaff());
    }

    function canWriteEaterySettings(docId) {
      return isAdmin();
    }

    function isValidAmount(value) {
      return value is number && value >= 0 && value <= 1000000000;
    }

    function isPositiveAmount(value) {
      return value is number && value > 0 && value <= 1000000000;
    }

    function isEateryScopedWrite(eateryId) {
      return isSignedIn()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId;
    }

    function isEateryImmutableUpdate(eateryId) {
      return resource.data.eateryId == eateryId
        && request.resource.data.eateryId == resource.data.eateryId;
    }

    function isCreatedBySelfOnCreate(data) {
      return !('createdBy' in data) || data.createdBy == request.auth.uid;
    }

    function isCreatedByImmutableOnUpdate() {
      return (!('createdBy' in resource.data)
          || request.resource.data.createdBy == resource.data.createdBy)
        && (!('createdBy' in request.resource.data)
          || request.resource.data.createdBy == request.auth.uid);
    }

    function hasValidOrderValues(data) {
      return data.items is list
        && data.items.size() <= 200
        && isValidAmount(data.totalAmount)
        && (!('amountReceived' in data) || isValidAmount(data.amountReceived))
        && (!('change' in data) || isValidAmount(data.change));
    }

    function hasValidMenuValues(data) {
      return (!('name' in data) || data.name is string)
        && (!('price' in data) || isValidAmount(data.price))
        && (!('cost' in data) || isValidAmount(data.cost))
        && (!('availableServings' in data)
          || (data.availableServings is number
            && data.availableServings >= 0
            && data.availableServings <= 1000000))
        && (!('isAvailable' in data) || data.isAvailable is bool);
    }

    function hasValidInventoryValues(data) {
      return (!('name' in data) || data.name is string)
        && (!('currentStock' in data)
          || (data.currentStock is number
            && data.currentStock >= 0
            && data.currentStock <= 1000000000))
        && (!('minStock' in data) || isValidAmount(data.minStock))
        && (!('reorderPoint' in data) || isValidAmount(data.reorderPoint))
        && (!('unitCost' in data) || isValidAmount(data.unitCost))
        && (!('sellingPrice' in data) || isValidAmount(data.sellingPrice));
    }

    function isEateryJoinMetadata(data) {
      return data.keys().hasOnly([
        'eateryId',
        'name',
        'ownerUid',
        'createdAt',
        'updatedAt'
      ])
        && data.eateryId is string
        && data.name is string
        && data.ownerUid is string;
    }

    function isEateryMember(eateryId) {
      return hasUserDoc()
        && userDoc().eateryId == eateryId
        && (isAdmin() || isApprovedStaff());
    }

    function isEateryAdmin(eateryId) {
      return isAdmin() && eateryId == userEateryId();
    }

    function hasValidNotificationPayload(payload) {
      return payload.keys().hasAll([
        'eateryId',
        'title',
        'body',
        'type',
        'source',
        'audience',
        'allowedRoles',
        'targetUids',
        'dedupeKey',
        'data',
        'active'
      ])
        && payload.title is string
        && payload.body is string
        && payload.type is string
        && payload.source is string
        && payload.audience is string
        && payload.allowedRoles is list
        && payload.targetUids is list
        && payload.dedupeKey is string
        && payload.data is map
        && payload.active is bool;
    }

    function hasDeterministicNotificationId(eateryId, id) {
      return id.matches(eateryId + '_.*');
    }

    function notificationRolesForUser() {
      return isAdmin()
        ? ['admin', 'manager', 'staff', 'all']
        : (hasUserDoc()
          && (userDoc().role == 'manager' || userDoc().role == 'owner')
          ? ['manager', 'staff', 'all']
          : ['staff', 'all']);
    }

    function legacyNotificationVisible(notification) {
      return isAdmin()
        || notification.audience in ['staff', 'all', 'everyone'];
    }

    function notificationVisibleToUser(notification) {
      return notification.eateryId == userEateryId()
        && (
          (notification.targetUids is list
            && request.auth.uid in notification.targetUids)
          || (notification.allowedRoles is list
            && notification.allowedRoles.hasAny(notificationRolesForUser()))
          || (!('allowedRoles' in notification)
            && legacyNotificationVisible(notification))
        );
    }

    function isValidSageBriefingCreate(eateryId) {
      return isAdmin()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId

        && request.resource.data.keys().hasAll([
          'eateryId',
          'title',
          'summary',
          'recommendation',
          'businessHealth',
          'detailText',
          'generatedAt',
          'period',
          'snapshot',
          'schemaVersion'
        ])

        && request.resource.data.keys().hasOnly([
          'eateryId',
          'title',
          'summary',
          'recommendation',
          'businessHealth',
          'detailText',
          'generatedAt',
          'period',
          'snapshot',
          'schemaVersion'
        ])

        && request.resource.data.title is string
        && request.resource.data.summary is string
        && request.resource.data.recommendation is string
        && request.resource.data.businessHealth is number
        && request.resource.data.detailText is string
        && request.resource.data.generatedAt is timestamp
        && request.resource.data.snapshot is map
        && request.resource.data.schemaVersion == 1
        && request.resource.data.period in [
          'morning',
          'afternoon',
          'evening'
        ];
    }

    // NEW: Staff/admin can complete orders
    function isOrderCompleteUpdate(eateryId) {
      return resource.data.status == 'pending'
        && isEateryImmutableUpdate(eateryId)
        && isCreatedByImmutableOnUpdate()
        && hasValidOrderValues(request.resource.data)
        && request.resource.data.status == 'completed'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status',
          'completedAt',
          'updatedAt',
          'paymentMethod',
          'amountReceived',
          'change',
          'referenceNumber',
          'paymentStatus'
        ]);
    }

    // NEW: Staff/admin can toggle menu availability (isAvailable only)
    function isMenuAvailabilityToggleUpdate(eateryId) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'isAvailable',
        'updatedAt'
      ]);
    }

    function isPendingOrderAppendUpdate(eateryId) {
      return resource.data.status == 'pending'
        && isEateryImmutableUpdate(eateryId)
        && isCreatedByImmutableOnUpdate()
        && hasValidOrderValues(request.resource.data)
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'items',
          'totalAmount',
          'updatedAt'
        ]);
    }

    function isPendingOrderVoidOrPartialVoidUpdate(eateryId) {
      return resource.data.status == 'pending'
        && isEateryImmutableUpdate(eateryId)
        && isCreatedByImmutableOnUpdate()
        && hasValidOrderValues(request.resource.data)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'items',
          'totalAmount',
          'status',
          'voidReason',
          'voidedAt',
          'voidedBy',
          'updatedAt'
        ])
        && request.resource.data.items is list
        && (request.resource.data.status == 'pending' || request.resource.data.status == 'voided');
    }

    // UPDATED: removed dependency on menu doc having eateryId field
    function isMenuStockOnlyUpdate(eateryId) {
      return (!('eateryId' in resource.data) || resource.data.eateryId == eateryId)
        && (!('createdBy' in resource.data)
            || request.resource.data.createdBy == resource.data.createdBy)
        && request.resource.data.availableServings is number
        && request.resource.data.availableServings >= 0
        && request.resource.data.availableServings <= 1000000
        && request.resource.data.isAvailable is bool
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'availableServings',
          'isAvailable',
          'updatedAt',
          'inventoryItemId'
        ]);
    }

    // UPDATED: removed dependency on inventory doc having eateryId field
    function isInventoryStockOnlyUpdate(eateryId) {
      return (!('eateryId' in resource.data) || resource.data.eateryId == eateryId)
        && (!('createdBy' in resource.data)
            || request.resource.data.createdBy == resource.data.createdBy)
        && request.resource.data.currentStock is number
        && request.resource.data.currentStock >= 0
        && request.resource.data.currentStock <= 1000000000
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'currentStock',
          'updatedAt'
        ]);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      allow read: if isAdmin() && resource.data.eateryId == userEateryId();

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.isAdmin is bool
        && request.resource.data.role is string
        && request.resource.data.eateryId is string
        && request.resource.data.eateryId.size() > 0
        && (
          // Joining an existing eatery: unapproved staff only. The eatery must
          // already exist so users cannot create profiles for phantom eateries.
          (
            request.resource.data.isAdmin == false
            && request.resource.data.role == 'staff'
            && request.resource.data.approved == false
            && exists(/databases/$(database)/documents/eateries/$(request.resource.data.eateryId))
          )
          // Creating a new eatery: must be its owner, and it must exist.
          || (
            request.resource.data.isAdmin == true
            && request.resource.data.role == 'admin'
            && exists(/databases/$(database)/documents/eateries/$(request.resource.data.eateryId))
            && get(/databases/$(database)/documents/eateries/$(request.resource.data.eateryId)).data.ownerUid == request.auth.uid
          )
        );

      // Self profile edits keep working, but privilege and membership fields
      // can never be changed by the user themselves.
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.isAdmin == resource.data.isAdmin
        && request.resource.data.role == resource.data.role
        && request.resource.data.eateryId == resource.data.eateryId
        && request.resource.data.approved == resource.data.approved;

      // Admins may only approve same-eatery staff. Role, admin status and
      // eatery membership are immutable through this path; all other user
      // profile changes require a privileged (Admin SDK) write.
      allow update: if isAdmin()
        && resource.data.eateryId == userEateryId()
        && request.resource.data.role == resource.data.role
        && request.resource.data.isAdmin == resource.data.isAdmin
        && request.resource.data.eateryId == resource.data.eateryId
        && (
          request.resource.data.approved == resource.data.approved
          || (
            (!('approved' in resource.data) || resource.data.approved != true)
            && request.resource.data.approved == true
          )
        )
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'approved',
          'approvedBy',
          'approvedAt',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    match /eateries/{eateryId} {
      // Eatery records are private to their owner/members. The narrow
      // exception is the minimal join metadata written by createEatery: a
      // signed-in user may read only that shape to look up an eatery ID.
      // Adding any other field to the document automatically makes it private.
      allow get: if isEateryMember(eateryId)
        || (isSignedIn() && isEateryJoinMetadata(resource.data));
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.eateryId == eateryId
        && isEateryJoinMetadata(request.resource.data);
      allow update, delete: if false;
    }

    match /eateries/{eateryId}/menu/{docId} {
      allow read: if canAccessEatery(eateryId);

      allow create: if isAdmin()
        && isEateryScopedWrite(eateryId)
        && hasValidMenuValues(request.resource.data)
        && isCreatedBySelfOnCreate(request.resource.data);

      allow update: if isEateryAdmin(eateryId)
        && isEateryImmutableUpdate(eateryId)
        && isCreatedByImmutableOnUpdate()
        && hasValidMenuValues(request.resource.data);

      allow delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;

      // Staff/admin stock-only updates (includes servings, isAvailable, inventory link)
      allow update: if canAccessEatery(eateryId)
        && isMenuStockOnlyUpdate(eateryId);

      // NEW: Staff/admin can toggle availability (isAvailable field only)
      allow update: if canAccessEatery(eateryId)
        && isMenuAvailabilityToggleUpdate(eateryId);
    }

    match /eateries/{eateryId}/orders/{docId} {
      allow read: if canAccessEatery(eateryId);

      // An order may be created as 'pending' (POS "Open Tab") or created
      // straight into 'completed' (POS "Complete"). Both are single writes that
      // deduct stock in the same transaction, so allowing either here keeps
      // that guarantee — completing an order afterwards would deduct twice.
      allow create: if isEateryScopedWrite(eateryId)
        && canAccessEatery(eateryId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.status in ['pending', 'completed']
        && hasValidOrderValues(request.resource.data);

      // Server-authoritative total recalculation is a follow-up; until then
      // admin edits must still keep the identity and bounds of the order.
      allow update: if isEateryAdmin(eateryId)
        && isEateryImmutableUpdate(eateryId)
        && isCreatedByImmutableOnUpdate()
        && hasValidOrderValues(request.resource.data);

      // Staff/admin: append items to pending orders
      allow update: if canAccessEatery(eateryId)
        && isPendingOrderAppendUpdate(eateryId);

      // Staff/admin: void/partial void on pending orders
      allow update: if canAccessEatery(eateryId)
        && isPendingOrderVoidOrPartialVoidUpdate(eateryId);

      // NEW: Staff/admin: complete orders
      allow update: if canAccessEatery(eateryId)
        && isOrderCompleteUpdate(eateryId);

      allow delete: if isAdmin()
        && eateryId == userEateryId();
    }

    match /eateries/{eateryId}/inventory/{docId} {
      allow read: if canAccessEatery(eateryId);

      allow create: if isAdmin()
        && isEateryScopedWrite(eateryId)
        && hasValidInventoryValues(request.resource.data)
        && isCreatedBySelfOnCreate(request.resource.data);

      allow update: if isEateryAdmin(eateryId)
        && isEateryImmutableUpdate(eateryId)
        && isCreatedByImmutableOnUpdate()
        && hasValidInventoryValues(request.resource.data);

      allow delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;

      // Staff/admin stock-only updates
      allow update: if canAccessEatery(eateryId)
        && isInventoryStockOnlyUpdate(eateryId);
    }

    match /eateries/{eateryId}/damaged_items/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if canAccessEatery(eateryId)
        && request.resource.data.eateryId == eateryId
        && request.resource.data.inventoryItemId is string
        && request.resource.data.quantity is number
        && request.resource.data.reason is string;
      allow update: if false;
      allow delete: if isAdmin()
        && eateryId == userEateryId();
    }

    match /eateries/{eateryId}/inventory_usage/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if isAdmin()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId;
      allow update, delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/recipes/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if isAdmin()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId;
      allow update, delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    // Inventory audit trail. Any eatery member (staff included) may append a
    // movement/receipt/adjustment since recording goods received and stock
    // changes is part of daily operations. Records are immutable once written;
    // only admins may remove them.
    match /eateries/{eateryId}/stock_movements/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if canAccessEatery(eateryId)
        && request.resource.data.eateryId == eateryId;
      allow update: if false;
      allow delete: if isAdmin()
        && eateryId == userEateryId();
    }

    // Purchase receipts are financial source documents: only admins (or the
    // Admin SDK) may create them. Receipts are schema-checked and immutable.
    match /eateries/{eateryId}/purchase_receipts/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if isAdmin()
        && isEateryScopedWrite(eateryId)
        && request.resource.data.keys().hasAll([
          'receiptNumber',
          'status',
          'items'
        ])
        && request.resource.data.receiptNumber is string
        && request.resource.data.status in ['received', 'pending', 'cancelled']
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 500
        && (!('receivedAt' in request.resource.data)
          || request.resource.data.receivedAt is string
          || request.resource.data.receivedAt is timestamp)
        && (!('supplierName' in request.resource.data)
          || request.resource.data.supplierName is string)
        && (!('total' in request.resource.data)
          || isValidAmount(request.resource.data.total));
      allow update: if false;
      allow delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/stock_adjustments/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if canAccessEatery(eateryId)
        && request.resource.data.eateryId == eateryId;
      allow update: if false;
      allow delete: if isAdmin()
        && eateryId == userEateryId();
    }

    match /eateries/{eateryId}/staff_profiles/{uid} {
      allow read: if canAccessEatery(eateryId);
      allow create: if isAdmin()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId
        && request.resource.data.uid == uid
        && request.resource.data.uid is string
        && request.resource.data.dailyRate is number
        && (!('halfDayMultiplier' in request.resource.data)
          || request.resource.data.halfDayMultiplier is number);
      allow update: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId
        && request.resource.data.eateryId == eateryId
        && request.resource.data.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.dailyRate is number
        && (!('halfDayMultiplier' in request.resource.data)
          || request.resource.data.halfDayMultiplier is number);
      allow delete: if false;
    }

    match /eateries/{eateryId}/sage_briefings/{docId} {
      // Approved staff and admins can view briefing history
      allow read: if canAccessEatery(eateryId);

      // Only admins can generate/save Sage Briefings
      allow create: if isValidSageBriefingCreate(eateryId);

      // Briefings are historical records and should never be edited
      allow update: if false;

      // Only admins may delete briefing records
      allow delete: if isAdmin()
        && eateryId == userEateryId();
    }

    match /eateries/{eateryId}/analytics_daily/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create, update, delete: if isAdmin() && eateryId == userEateryId();
    }

    match /eateries/{eateryId}/predictions/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create, update, delete: if isAdmin() && eateryId == userEateryId();
    }

    // Expenses are ledger entries. The old "any member may post an
    // inventory_purchase expense" branch allowed forged costs and is gone:
    // posting expenses (including GRN mirrors) is admin/server-only.
    match /eateries/{eateryId}/expenses/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if isAdmin()
        && isEateryScopedWrite(eateryId)
        && request.resource.data.keys().hasAll(['name', 'amount'])
        && request.resource.data.name is string
        && isPositiveAmount(request.resource.data.amount)
        && (!('source' in request.resource.data)
          || request.resource.data.source is string);
      allow update: if isEateryAdmin(eateryId)
        && isEateryImmutableUpdate(eateryId)
        && isPositiveAmount(request.resource.data.amount);
      allow delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/payables/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if isAdmin()
        && isEateryScopedWrite(eateryId)
        && request.resource.data.keys().hasAll(['name', 'amount'])
        && request.resource.data.name is string
        && isValidAmount(request.resource.data.amount)
        && (!('status' in request.resource.data)
          || request.resource.data.status in ['unpaid', 'paid', 'overdue', 'cancelled']);
      allow update: if isEateryAdmin(eateryId)
        && isEateryImmutableUpdate(eateryId)
        && isValidAmount(request.resource.data.amount)
        && (!('status' in request.resource.data)
          || request.resource.data.status in ['unpaid', 'paid', 'overdue', 'cancelled']);
      allow delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/notifications/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if isApprovedStaff()
        && isEateryScopedWrite(eateryId)
        && hasValidNotificationPayload(request.resource.data)
        && hasDeterministicNotificationId(eateryId, docId);
      allow update: if canAccessEatery(eateryId)
        && isEateryImmutableUpdate(eateryId)
        && (isAdmin()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'readBy',
            'isRead',
            'readAt',
            'updatedAt'
          ]));
      allow delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/settings/{docId} {
      // All settings are admin-only to write. SMS settings (alert routing)
      // remain admin-only to read; other operational settings stay readable
      // by approved members of the eatery.
      allow read: if canAccessEatery(eateryId)
        && (docId != 'sms' || isAdmin());
      allow create: if isAdmin()
        && isEateryScopedWrite(eateryId);
      allow update: if isEateryAdmin(eateryId)
        && isEateryImmutableUpdate(eateryId);
      allow delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/sms_logs/{docId} {
      allow read: if isAdmin() && eateryId == userEateryId();
      allow create: if isAdmin() && eateryId == userEateryId();
      allow update: if isAdmin() && eateryId == userEateryId();
      allow delete: if false;
    }

    match /eateries/{eateryId}/sms_alert_state/{docId} {
      allow read: if isAdmin() && eateryId == userEateryId();
      allow create: if isAdmin() && eateryId == userEateryId();
      allow update: if isAdmin() && eateryId == userEateryId();
      allow delete: if false;
    }

    match /menu/{docId} {
      allow read, write: if false;
    }

    match /orders/{docId} {
      // Temporary read compatibility for records awaiting migration.
      allow read: if canAccessEateryData(resource.data.eateryId);
      allow write: if false;
    }

    match /inventory/{docId} {
      // Temporary read compatibility for records awaiting migration.
      allow read: if canAccessEateryData(resource.data.eateryId);
      allow write: if false;
    }

    match /damaged_items/{docId} {
      // Temporary read compatibility for records awaiting migration.
      allow read: if canAccessEateryData(resource.data.eateryId);
      allow write: if false;
    }

    match /inventory_usage/{docId} {
      allow read, write: if false;
    }

    match /analytics/{docId} {
      allow read, write: if false;
    }

    match /recipes/{docId} {
      allow read, write: if false;
    }

    match /staff_profiles/{docId} {
      allow read, write: if false;
    }

    match /eateries/{eateryId}/staff_attendance/{docId} {
      allow read: if canAccessEatery(eateryId);

      // Staff clock in for themselves; admins can encode on anyone's behalf.
      allow create: if canAccessEatery(eateryId)
        && request.resource.data.eateryId == eateryId
        && request.resource.data.uid is string
        && request.resource.data.date is string
        && (
          (
            request.resource.data.uid == request.auth.uid
            && request.resource.data.timeIn is timestamp
            && request.resource.data.timeIn == request.time
            && request.resource.data.present == true
            && request.resource.data.workUnit == 0.0
            && request.resource.data.status == 'in_progress'
            && request.resource.data.keys().hasOnly([
              'eateryId',
              'uid',
              'date',
              'timeIn',
              'present',
              'workUnit',
              'status',
              'source',
              'scheduledStart',
              'late',
              'lateMinutes',
              'needsReview',
              'createdAt',
              'updatedAt'
            ])
            && (!('source' in request.resource.data)
              || request.resource.data.source == 'self')
          )
          || (
            isAdmin()
            && request.resource.data.present is bool
            && (!('workUnit' in request.resource.data)
              || request.resource.data.workUnit is number)
          )
        );

      // Staff may only close an open shift with server timestamps. Admins may
      // edit any attendance record and override the derived work unit.
      allow update: if canAccessEatery(eateryId)
        && resource.data.eateryId == eateryId
        && request.resource.data.eateryId == resource.data.eateryId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.date == resource.data.date
        && (
          (
            request.resource.data.uid == request.auth.uid
            && (
              (
                (!('timeOut' in resource.data)
                  || resource.data.timeOut == null)
                && request.resource.data.timeOut is timestamp
                && request.resource.data.timeOut == request.time
                && request.resource.data.hoursWorked is number
                && request.resource.data.hoursWorked >= 0
                && (request.resource.data.workUnit == 0.0
                  || request.resource.data.workUnit == 0.5
                  || request.resource.data.workUnit == 1.0)
                && request.resource.data.diff(resource.data).changedKeys().hasOnly([
                  'timeOut',
                  'hoursWorked',
                  'workUnit',
                  'status',
                  'present',
                  'needsReview',
                  'updatedAt'
                ])
              )
              || (
                (!('timeIn' in resource.data)
                  || resource.data.timeIn == null)
                && (!('timeOut' in resource.data)
                  || resource.data.timeOut == null)
                && request.resource.data.timeIn is timestamp
                && request.resource.data.timeIn == request.time
                && request.resource.data.workUnit == 0.0
                && request.resource.data.status == 'in_progress'
                && request.resource.data.diff(resource.data).changedKeys().hasOnly([
                  'timeIn',
                  'present',
                  'workUnit',
                  'status',
                  'source',
                  'scheduledStart',
                  'late',
                  'lateMinutes',
                  'needsReview',
                  'updatedAt'
                ])
              )
            )
          )
          || (
            isAdmin()
            && request.resource.data.present is bool
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'present',
              'workUnit',
              'status',
              'notes',
              'updatedAt',
              'createdAt',
              'timeIn',
              'timeOut',
              'hoursWorked',
              'needsReview',
              'source',
              'scheduledStart',
              'late',
              'lateMinutes',
              'editedByUid',
              'editedAt'
            ])
          )
        );

      allow delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/admin_profiles/{uid} {
      allow read: if canAccessEatery(eateryId);
      allow create: if isAdmin()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId
        && request.resource.data.uid == uid
        && request.resource.data.uid is string;
      allow update: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId
        && request.resource.data.eateryId == resource.data.eateryId
        && request.resource.data.uid == uid
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/staff_meals/{docId} {
      allow read: if canAccessEatery(eateryId);
      // Staff may only order meals for themselves; admins may order on behalf.
      allow create: if canAccessEatery(eateryId)
        && request.resource.data.eateryId == eateryId
        && request.resource.data.staffId is string
        && (request.resource.data.staffId == request.auth.uid || isAdmin())
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.status in ['pending', 'completed'];
      // Only admins may change the fulfilment status of a meal order.
      allow update: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId
        && request.resource.data.eateryId == resource.data.eateryId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['pending', 'completed', 'cancelled'];
      allow delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/payroll_payouts/{docId} {
      // Admins see all payouts; staff may only read their own history.
      allow read: if (isAdmin() && eateryId == userEateryId())
        || (canAccessEatery(eateryId) && resource.data.uid == request.auth.uid);
      // Only admins may record payouts, and only on their own behalf.
      allow create: if isAdmin()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId
        && request.resource.data.uid is string
        && request.resource.data.weekStart is string
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.paidByUid == request.auth.uid
        && (!('type' in request.resource.data)
          || request.resource.data.type in ['weekly', 'advance']);
      allow update: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId
        && request.resource.data.eateryId == resource.data.eateryId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.weekStart == resource.data.weekStart
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && (!('type' in request.resource.data)
          || !('type' in resource.data)
          || request.resource.data.type == resource.data.type);
      allow delete: if false;
    }

    match /notifications/{docId} {
      allow read: if canAccessEateryData(resource.data.eateryId)
        && notificationVisibleToUser(resource.data);
      // System/server notifications are written with the Admin SDK and bypass
      // these rules. Client-created notifications must come from an approved
      // member of the addressed eatery, match a known schema and use the
      // deterministic "<eateryId>_<dedupeKey>" document id.
      allow create: if isApprovedStaff()
        && request.resource.data.eateryId == userEateryId()
        && hasValidNotificationPayload(request.resource.data)
        && hasDeterministicNotificationId(request.resource.data.eateryId, docId);
      allow update: if canAccessEateryData(resource.data.eateryId)
        && request.resource.data.eateryId == resource.data.eateryId
        && (isAdmin()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'readBy',
            'isRead',
            'readAt',
            'updatedAt'
          ]));
      allow delete: if isAdmin()
        && resource.data.eateryId == userEateryId();
    }

    match /user_preferences/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && (!('userId' in request.resource.data) || request.resource.data.userId == userId)
        && request.resource.data.keys().hasOnly([
          'userId',
          'notificationsEnabled',
          'lowStockEnabled',
          'billRemindersEnabled',
          'orderAlertsEnabled',
          'attendanceRemindersEnabled',
          'billReminderDays',
          'currencySymbol',
          'updatedAt'
        ]);

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && (!('userId' in request.resource.data) || request.resource.data.userId == userId)
        && (!('userId' in resource.data) || resource.data.userId == userId)
        && request.resource.data.keys().hasOnly([
          'userId',
          'notificationsEnabled',
          'lowStockEnabled',
          'billRemindersEnabled',
          'orderAlertsEnabled',
          'attendanceRemindersEnabled',
          'billReminderDays',
          'currencySymbol',
          'updatedAt'
        ]);

      allow delete: if false;
    }
  }
}
