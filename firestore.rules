rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /email_verifications/{docId} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserDoc() {
      return isSignedIn() && exists(userDocPath());
    }

    function userDoc() {
      return hasUserDoc() ? get(userDocPath()).data : null;
    }

    function userEateryId() {
      return hasUserDoc() ? userDoc().eateryId : null;
    }

    function isAdmin() {
      return hasUserDoc() && (
        userDoc().isAdmin == true
        || userDoc().role == 'admin'
      );
    }

    function isApprovedStaff() {
      return hasUserDoc() && (
        userDoc().approved == true
        || userDoc().role == 'admin'
        || userDoc().isAdmin == true
        // Legacy accounts predate the approval flag and are treated as approved.
        || !('approved' in userDoc())
      );
    }

    function canAccessEateryData(docEateryId) {
      return hasUserDoc()
        && docEateryId == userEateryId()
        && (isAdmin() || isApprovedStaff());
    }

    function canAccessEatery(eateryId) {
      return hasUserDoc()
        && userDoc().eateryId == eateryId
        && (isAdmin() || isApprovedStaff());
    }

    function isValidSageBriefingCreate(eateryId) {
      return isAdmin()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId

        && request.resource.data.keys().hasAll([
          'eateryId',
          'title',
          'summary',
          'recommendation',
          'businessHealth',
          'detailText',
          'generatedAt',
          'period',
          'snapshot',
          'schemaVersion'
        ])

        && request.resource.data.keys().hasOnly([
          'eateryId',
          'title',
          'summary',
          'recommendation',
          'businessHealth',
          'detailText',
          'generatedAt',
          'period',
          'snapshot',
          'schemaVersion'
        ])

        && request.resource.data.title is string
        && request.resource.data.summary is string
        && request.resource.data.recommendation is string
        && request.resource.data.businessHealth is number
        && request.resource.data.detailText is string
        && request.resource.data.generatedAt is timestamp
        && request.resource.data.snapshot is map
        && request.resource.data.schemaVersion == 1
        && request.resource.data.period in [
          'morning',
          'afternoon',
          'evening'
        ];
    }

    // NEW: Staff/admin can complete orders
    function isOrderCompleteUpdate(eateryId) {
      return resource.data.status == 'pending'
        && request.resource.data.eateryId == resource.data.eateryId
        && request.resource.data.eateryId == eateryId
        && request.resource.data.status == 'completed'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status',
          'completedAt',
          'updatedAt',
          'paymentMethod',
          'amountReceived',
          'change',
          'referenceNumber',
          'paymentStatus'
        ]);
    }

    // NEW: Staff/admin can toggle menu availability (isAvailable only)
    function isMenuAvailabilityToggleUpdate(eateryId) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'isAvailable',
        'updatedAt'
      ]);
    }

    function isPendingOrderAppendUpdate(eateryId) {
      return resource.data.status == 'pending'
        && request.resource.data.eateryId == resource.data.eateryId
        && request.resource.data.eateryId == eateryId
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'items',
          'totalAmount',
          'updatedAt'
        ])
        && request.resource.data.items is list
        && request.resource.data.totalAmount is number;
    }

    function isPendingOrderVoidOrPartialVoidUpdate(eateryId) {
      return resource.data.status == 'pending'
        && request.resource.data.eateryId == resource.data.eateryId
        && request.resource.data.eateryId == eateryId
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'items',
          'totalAmount',
          'status',
          'voidReason',
          'voidedAt',
          'voidedBy',
          'updatedAt'
        ])
        && request.resource.data.items is list
        && request.resource.data.totalAmount is number
        && (request.resource.data.status == 'pending' || request.resource.data.status == 'voided');
    }

    // UPDATED: removed dependency on menu doc having eateryId field
    function isMenuStockOnlyUpdate(eateryId) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'availableServings',
        'isAvailable',
        'updatedAt',
        'inventoryItemId'
      ]);
    }

    // UPDATED: removed dependency on inventory doc having eateryId field
    function isInventoryStockOnlyUpdate(eateryId) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'currentStock',
        'updatedAt'
      ]);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      allow read: if isAdmin() && resource.data.eateryId == userEateryId();

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.isAdmin is bool
        && request.resource.data.role is string
        && request.resource.data.eateryId is string
        && (
          // Joining an existing eatery: unapproved staff only.
          (
            request.resource.data.isAdmin == false
            && request.resource.data.role != 'admin'
            && request.resource.data.approved == false
          )
          // Creating a new eatery: must be its owner, and it must exist.
          || (
            request.resource.data.isAdmin == true
            && request.resource.data.role == 'admin'
            && exists(/databases/$(database)/documents/eateries/$(request.resource.data.eateryId))
            && get(/databases/$(database)/documents/eateries/$(request.resource.data.eateryId)).data.ownerUid == request.auth.uid
          )
        );

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.isAdmin == resource.data.isAdmin
        && request.resource.data.role == resource.data.role
        && request.resource.data.eateryId == resource.data.eateryId
        && request.resource.data.approved == resource.data.approved;

      allow update: if isAdmin()
        && resource.data.eateryId == userEateryId();

      allow delete: if false;
    }

    match /eateries/{eateryId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.eateryId == eateryId;
      allow update, delete: if false;
    }

    match /eateries/{eateryId}/menu/{docId} {
      allow read: if canAccessEatery(eateryId);

      allow create: if isAdmin()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId;

      allow update, delete: if isAdmin()
        && eateryId == userEateryId();

      // Staff/admin stock-only updates (includes servings, isAvailable, inventory link)
      allow update: if canAccessEatery(eateryId)
        && isMenuStockOnlyUpdate(eateryId);

      // NEW: Staff/admin can toggle availability (isAvailable field only)
      allow update: if canAccessEatery(eateryId)
        && isMenuAvailabilityToggleUpdate(eateryId);
    }

    match /eateries/{eateryId}/orders/{docId} {
      allow read: if canAccessEatery(eateryId);

      // An order may be created as 'pending' (POS "Open Tab") or created
      // straight into 'completed' (POS "Complete"). Both are single writes that
      // deduct stock in the same transaction, so allowing either here keeps
      // that guarantee — completing an order afterwards would deduct twice.
      allow create: if canAccessEatery(eateryId)
        && request.resource.data.eateryId == eateryId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.status in ['pending', 'completed'];

      allow update: if isAdmin()
        && eateryId == userEateryId();

      // Staff/admin: append items to pending orders
      allow update: if canAccessEatery(eateryId)
        && isPendingOrderAppendUpdate(eateryId);

      // Staff/admin: void/partial void on pending orders
      allow update: if canAccessEatery(eateryId)
        && isPendingOrderVoidOrPartialVoidUpdate(eateryId);

      // NEW: Staff/admin: complete orders
      allow update: if canAccessEatery(eateryId)
        && isOrderCompleteUpdate(eateryId);

      allow delete: if isAdmin()
        && eateryId == userEateryId();
    }

    match /eateries/{eateryId}/inventory/{docId} {
      allow read: if canAccessEatery(eateryId);

      allow create: if isAdmin()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId;

      allow update, delete: if isAdmin()
        && eateryId == userEateryId();

      // Staff/admin stock-only updates
      allow update: if canAccessEatery(eateryId)
        && isInventoryStockOnlyUpdate(eateryId);
    }

    match /eateries/{eateryId}/damaged_items/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if canAccessEatery(eateryId)
        && request.resource.data.eateryId == eateryId
        && request.resource.data.inventoryItemId is string
        && request.resource.data.quantity is number
        && request.resource.data.reason is string;
      allow update: if false;
      allow delete: if isAdmin()
        && eateryId == userEateryId();
    }

    match /eateries/{eateryId}/inventory_usage/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if isAdmin()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId;
      allow update, delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/recipes/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if isAdmin()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId;
      allow update, delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    // Inventory audit trail. Any eatery member (staff included) may append a
    // movement/receipt/adjustment since recording goods received and stock
    // changes is part of daily operations. Records are immutable once written;
    // only admins may remove them.
    match /eateries/{eateryId}/stock_movements/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if canAccessEatery(eateryId)
        && request.resource.data.eateryId == eateryId;
      allow update: if false;
      allow delete: if isAdmin()
        && eateryId == userEateryId();
    }

    match /eateries/{eateryId}/purchase_receipts/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if canAccessEatery(eateryId)
        && request.resource.data.eateryId == eateryId;
      allow update: if false;
      allow delete: if isAdmin()
        && eateryId == userEateryId();
    }

    match /eateries/{eateryId}/stock_adjustments/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if canAccessEatery(eateryId)
        && request.resource.data.eateryId == eateryId;
      allow update: if false;
      allow delete: if isAdmin()
        && eateryId == userEateryId();
    }

    match /eateries/{eateryId}/staff_profiles/{uid} {
      allow read: if canAccessEatery(eateryId);
      allow create: if isAdmin()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId
        && request.resource.data.uid == uid
        && request.resource.data.uid is string
        && request.resource.data.dailyRate is number
        && (!('halfDayMultiplier' in request.resource.data)
          || request.resource.data.halfDayMultiplier is number);
      allow update: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId
        && request.resource.data.eateryId == eateryId
        && request.resource.data.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.dailyRate is number
        && (!('halfDayMultiplier' in request.resource.data)
          || request.resource.data.halfDayMultiplier is number);
      allow delete: if false;
    }

    match /eateries/{eateryId}/sage_briefings/{docId} {
      // Approved staff and admins can view briefing history
      allow read: if canAccessEatery(eateryId);

      // Only admins can generate/save Sage Briefings
      allow create: if isValidSageBriefingCreate(eateryId);

      // Briefings are historical records and should never be edited
      allow update: if false;

      // Only admins may delete briefing records
      allow delete: if isAdmin()
        && eateryId == userEateryId();
    }

    match /eateries/{eateryId}/analytics_daily/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create, update, delete: if isAdmin() && eateryId == userEateryId();
    }

    match /eateries/{eateryId}/predictions/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create, update, delete: if isAdmin() && eateryId == userEateryId();
    }

    match /eateries/{eateryId}/expenses/{docId} {
      allow read: if canAccessEatery(eateryId);
      // Admins may record any expense. Any eatery member may create the
      // auto-posted expense that mirrors an inventory purchase (GRN) so that
      // recording goods received always produces a matching cost entry.
      allow create: if isSignedIn()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId
        && (
          isAdmin()
          || (
            request.resource.data.source == 'inventory_purchase'
            && request.resource.data.linkedPurchaseId is string
            && request.resource.data.amount > 0
          )
        );
      allow update, delete: if isSignedIn()
        && isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/payables/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if canAccessEatery(eateryId)
        && request.resource.data.eateryId == eateryId
        && request.resource.data.keys().hasAll(['name', 'amount']);
      allow update: if canAccessEatery(eateryId)
        && resource.data.eateryId == eateryId
        && request.resource.data.eateryId == eateryId;
      allow delete: if isSignedIn()
        && isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/notifications/{docId} {
      allow read: if canAccessEatery(eateryId);
      allow create: if isSignedIn()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId;
      allow update: if isSignedIn()
        && canAccessEatery(eateryId)
        && resource.data.eateryId == eateryId
        && request.resource.data.eateryId == eateryId;
      allow delete: if isSignedIn()
        && isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/settings/{docId} {
      // SMS settings contain the alert configuration and are admin-only.
      allow read: if canAccessEatery(eateryId)
        && (docId != 'sms' || isAdmin());
      allow create: if canAccessEatery(eateryId)
        && (docId != 'sms' || isAdmin())
        && request.resource.data.eateryId == eateryId;
      allow update: if canAccessEatery(eateryId)
        && (docId != 'sms' || isAdmin())
        && resource.data.eateryId == eateryId
        && request.resource.data.eateryId == eateryId;
      allow delete: if isAdmin()
        && eateryId == userEateryId()
        && (docId != 'sms' || isAdmin())
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/sms_logs/{docId} {
      allow read: if isAdmin() && eateryId == userEateryId();
      allow create: if isAdmin() && eateryId == userEateryId();
      allow update: if isAdmin() && eateryId == userEateryId();
      allow set: if isAdmin() && eateryId == userEateryId();
      allow delete: if false;
    }

    match /eateries/{eateryId}/sms_alert_state/{docId} {
      allow read: if isAdmin() && eateryId == userEateryId();
      allow create: if isAdmin() && eateryId == userEateryId();
      allow update: if isAdmin() && eateryId == userEateryId();
      allow set: if isAdmin() && eateryId == userEateryId();
      allow delete: if false;
    }

    match /menu/{docId} {
      allow read, write: if false;
    }

    match /orders/{docId} {
      // Temporary read compatibility for records awaiting migration.
      allow read: if canAccessEateryData(resource.data.eateryId);
      allow write: if false;
    }

    match /inventory/{docId} {
      // Temporary read compatibility for records awaiting migration.
      allow read: if canAccessEateryData(resource.data.eateryId);
      allow write: if false;
    }

    match /damaged_items/{docId} {
      // Temporary read compatibility for records awaiting migration.
      allow read: if canAccessEateryData(resource.data.eateryId);
      allow write: if false;
    }

    match /inventory_usage/{docId} {
      allow read, write: if false;
    }

    match /analytics/{docId} {
      allow read, write: if false;
    }

    match /recipes/{docId} {
      allow read, write: if false;
    }

    match /staff_profiles/{docId} {
      allow read, write: if false;
    }

    match /eateries/{eateryId}/staff_attendance/{docId} {
      allow read: if canAccessEatery(eateryId);

      // Staff can create their own attendance record for self check-in.
      // Admins can encode attendance on behalf of any staff member.
      allow create: if canAccessEatery(eateryId)
        && request.resource.data.eateryId == eateryId
        && request.resource.data.uid is string
        && request.resource.data.date is string
        && (
          (
            request.resource.data.uid == request.auth.uid
            && (
              ('morningCheckIn' in request.resource.data
                && request.resource.data.morningCheckIn is string)
              || ('afternoonCheckIn' in request.resource.data
                && request.resource.data.afternoonCheckIn is string)
            )
            && (!('workUnit' in request.resource.data)
              || request.resource.data.workUnit == 0.5
              || request.resource.data.workUnit == 1.0)
          )
          || (
            isAdmin()
            && request.resource.data.present is bool
            && (!('workUnit' in request.resource.data)
              || request.resource.data.workUnit is number)
          )
        );

      // Staff may only add their own check-in timestamps (and the derived
      // present/workUnit/status values). Admins may edit the attendance record.
      allow update: if canAccessEatery(eateryId)
        && resource.data.eateryId == eateryId
        && request.resource.data.eateryId == resource.data.eateryId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.date == resource.data.date
        && (
          (
            request.resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'morningCheckIn',
              'afternoonCheckIn',
              'present',
              'workUnit',
              'status',
              'updatedAt',
              'createdAt'
            ])
            && (!('workUnit' in request.resource.data)
              || request.resource.data.workUnit == 0.5
              || request.resource.data.workUnit == 1.0)
          )
          || (
            isAdmin()
            && request.resource.data.present is bool
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'present',
              'workUnit',
              'status',
              'notes',
              'updatedAt',
              'morningCheckIn',
              'afternoonCheckIn',
              'createdAt'
            ])
          )
        );

      allow delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/admin_profiles/{uid} {
      allow read: if canAccessEatery(eateryId);
      allow create: if isAdmin()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId
        && request.resource.data.uid == uid
        && request.resource.data.uid is string;
      allow update: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId
        && request.resource.data.eateryId == resource.data.eateryId
        && request.resource.data.uid == uid
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/staff_meals/{docId} {
      allow read: if canAccessEatery(eateryId);
      // Staff may only order meals for themselves; admins may order on behalf.
      allow create: if canAccessEatery(eateryId)
        && request.resource.data.eateryId == eateryId
        && request.resource.data.staffId is string
        && (request.resource.data.staffId == request.auth.uid || isAdmin())
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.status in ['pending', 'completed'];
      // Only admins may change the fulfilment status of a meal order.
      allow update: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId
        && request.resource.data.eateryId == resource.data.eateryId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['pending', 'completed', 'cancelled'];
      allow delete: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId;
    }

    match /eateries/{eateryId}/payroll_payouts/{docId} {
      // Admins see all payouts; staff may only read their own history.
      allow read: if (isAdmin() && eateryId == userEateryId())
        || (canAccessEatery(eateryId) && resource.data.uid == request.auth.uid);
      // Only admins may record payouts, and only on their own behalf.
      allow create: if isAdmin()
        && eateryId == userEateryId()
        && request.resource.data.eateryId == eateryId
        && request.resource.data.uid is string
        && request.resource.data.weekStart is string
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.paidByUid == request.auth.uid
        && (!('type' in request.resource.data)
          || request.resource.data.type in ['weekly', 'advance']);
      allow update: if isAdmin()
        && eateryId == userEateryId()
        && resource.data.eateryId == eateryId
        && request.resource.data.eateryId == resource.data.eateryId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.weekStart == resource.data.weekStart
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && (!('type' in request.resource.data)
          || !('type' in resource.data)
          || request.resource.data.type == resource.data.type);
      allow delete: if false;
    }

    match /notifications/{docId} {
      allow read: if isSignedIn()
        && resource.data.eateryId == userEateryId()
        && (isAdmin() || isApprovedStaff());
      allow create: if isSignedIn()
        && request.resource.data.eateryId == userEateryId();
      allow update: if isSignedIn()
        && resource.data.eateryId == userEateryId()
        && request.resource.data.eateryId == resource.data.eateryId
        && (isAdmin() || isApprovedStaff());
      allow delete: if isSignedIn()
        && isAdmin()
        && resource.data.eateryId == userEateryId();
    }

    match /user_preferences/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && (!('userId' in request.resource.data) || request.resource.data.userId == userId)
        && request.resource.data.keys().hasOnly([
          'userId',
          'notificationsEnabled',
          'lowStockEnabled',
          'billRemindersEnabled',
          'orderAlertsEnabled',
          'billReminderDays',
          'currencySymbol',
          'updatedAt'
        ]);

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && (!('userId' in request.resource.data) || request.resource.data.userId == userId)
        && (!('userId' in resource.data) || resource.data.userId == userId)
        && request.resource.data.keys().hasOnly([
          'userId',
          'notificationsEnabled',
          'lowStockEnabled',
          'billRemindersEnabled',
          'orderAlertsEnabled',
          'billReminderDays',
          'currencySymbol',
          'updatedAt'
        ]);

      allow delete: if false;
    }
  }
}
